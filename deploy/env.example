# Non-secret settings for whatsapp-bridge.service and whatsapp-mcp-server.service.
# Install as ~/.config/whatsapp-mcp.env (mode 0600). The bearer token is NOT here:
# it lives in SSM Parameter Store (MCP_TOKEN_PARAM) and is read at start.

# Shared state: the bridge keeps $DATA_DIR/store/{whatsapp.db,messages.db,media,.bridge-token}
DATA_DIR=/home/ec2-user/.whatsapp-data

# Bridge (Go), loopback only
WHATSAPP_BRIDGE_PORT=8790
WHATSAPP_DEVICE_NAME="Claude MCP"
# DEBUG would log raw stanzas (QR payloads, message contents) to journald
WHATSAPP_LOG_LEVEL=INFO
# No webhook consumer on this host
WEBHOOK_ENABLED=false
# Files send_file/send_audio_message may send (paths on this server)
WHATSAPP_MEDIA_ROOTS=/home/ec2-user/.whatsapp-data/outbox

# MCP server (Python), loopback only; reached through Cloudflare Tunnel
WHATSAPP_API_URL=http://127.0.0.1:8790/api
WHATSAPP_MCP_HOST=127.0.0.1
WHATSAPP_MCP_PORT=8791
PUBLIC_HOST=local.sheiksadi.dev
BASE_PATH=/whatsapp
MCP_TOKEN_PARAM=/whatsapp-mcp/auth-token
AWS_REGION=ap-southeast-2
